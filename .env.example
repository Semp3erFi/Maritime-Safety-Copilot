# Copy to Day18/.env and replace placeholders. Existing environment wins.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_API_VERSION=your-supported-api-version
AZURE_OPENAI_CHAT_DEPLOYMENT=your-chat-deployment-name
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=your-embedding-deployment-name

# Streamlit talks only to this local API.
BACKEND_URL=http://127.0.0.1:8000

# Optional telemetry: all three values must be set, and the optional SDK installed.
# Leave blank for no tracing. Use your own local Langfuse instance for local-only traces.
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""
LANGFUSE_BASE_URL="http://localhost:3000"
